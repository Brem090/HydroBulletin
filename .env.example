# Скопіюйте цей файл як .env і заповніть лише у власному середовищі.
# Файл .env виключено з Git.
HYDRO_SOURCE_USERNAME=
HYDRO_SOURCE_PASSWORD=
HYDRO_SOURCE_TIMEOUT=40
HYDRO_SOURCE_ATTEMPTS=3
HYDRO_SOURCE_RETRY_DELAY=1.5

# Адреси вже мають робочі значення у програмі. Ці два рядки потрібні лише
# для явного перевизначення серверів у конкретному середовищі.
# HYDRO_SOURCE_PRIMARY_URL=http://gcst.meteo.gov.ua/armua
# HYDRO_SOURCE_MIRROR_URL=http://rgcst.meteo.gov.ua/armua
